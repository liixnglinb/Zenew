{
  "name": "zenew-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "知新 Zenew 云端网关（Cloudflare Workers + D1）：账号 / LLM 代理 / 额度计量",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute zenew --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute zenew --local --file schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
