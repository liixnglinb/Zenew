{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zenew",
  "version": "0.3.0",
  "identifier": "com.zenew.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "知新 Zenew",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxRDhBNDZBREIwQUU2OApSV1JvcnJDdFJvb2RCK1FseFcxRDFBaTVpaWQ2SnZ3RWZKS3ZrTjFnRGZ2K0x0aFVZNUZVYTRCNAo=",
      "endpoints": [
        "https://github.com/liixnglinb/Zenew/releases/latest/download/latest.json"
      ]
    }
  }
}
