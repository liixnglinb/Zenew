{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Zenew 桌面默认权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "updater:default",
    "process:allow-restart",
    "opener:allow-open-url"
  ]
}
